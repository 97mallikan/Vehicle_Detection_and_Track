YOLO_STRIDE = 5
WARMUP_FRAMES = 1

# Motion anomaly settings
MOTION_WINDOW = 150
MIN_MOTION_SAMPLES = 8
MIN_FLOW_SPEED = 0.75
LOCAL_FLOW_COS_ANOM_THR = 0.75
ANOMALY_PERSIST_FRAMES = 4

MIN_HITS_TO_ACTIVATE = 1
TENTATIVE_MAX_MISSES = 1 * YOLO_STRIDE
ACTIVE_MAX_MISSES = 100
ACTIVE_PRED_ONLY_MAX = max(50, YOLO_STRIDE * 2)

HIGH_CONF = 0.55
SPAWN_CONF_THR = 0.60
MIN_BOX_AREA = 900
SPAWN_MOTION_THR = 0.02

# Kalman tuning
VEL_DAMP = 0.97
R_YOLO   = 2.0
R_BLOB   = 30.0
Q_SCALE  = 25.0

# Association
BASE_GATE = 60
K_GATE    = 1.5
MAX_GATE  = 220

# IO
INPUT_VIDEO = "RealLifeVideo.mp4"
YOLO_MODEL  = "yolo26s.pt"
DEVICE      = "cuda"

USE_OPENCV_CUDA = True

USE_CUSTOM_CUDA_BACKEND = True
CUDA_BACKEND_LIB = "./libmotion_backend.so"
CUDA_BACKEND_MIN_AREA = 800